# Environment Variables for Advanced Leave Calculator

# API Ninjas Key for fetching public holidays
# Get your free API key from: https://api.api-ninjas.com/
# Note: This should be handled server-side in production for security
VITE_API_NINJAS_KEY=your_api_key_here

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (for server-side operations and keep-alive)
# Get this from your Supabase project settings -> API -> service_role key
# WARNING: Keep this private and never expose to the browser
VITE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# A secret key you make up. Keep this private.
VITE_ADMIN_SECRET_KEY="your-super-secret-password"
VITE_SUPERBASE_PROJECT_PASSWORD="password_for_your_project"